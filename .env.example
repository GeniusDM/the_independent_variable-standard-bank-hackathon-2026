# Copy this file to .env and fill in ONE provider. .env is git-ignored.
# With no provider set, the AI features fall back to deterministic templates —
# the dashboard still works, it just writes less naturally.

# ---------------------------------------------------------------------------
# Option 1 — Google Gemini (recommended: genuinely free tier, no card required)
# Get a key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GENAI_PROVIDER=gemini
GEMINI_API_KEY=<your-google-ai-studio-key>

# ---------------------------------------------------------------------------
# Option 2 — a local model via Ollama. No key, no cost, runs offline.
#   winget install Ollama.Ollama   (or https://ollama.com/download)
#   ollama pull gemma3:4b
# Slower on a CPU-only machine, but nothing leaves the laptop.
# ---------------------------------------------------------------------------
# GENAI_PROVIDER=ollama
# OLLAMA_MODEL=gemma3:4b
# OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------------------
# Option 3 — a paid API, if a key is available
# ---------------------------------------------------------------------------
# GENAI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=<your-anthropic-key>     # needs: pip install anthropic
# GENAI_PROVIDER=openai
# OPENAI_API_KEY=<your-openai-key>

# Optional: override the model chosen for the active provider.
# GENAI_MODEL=gemini-2.0-flash

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Data paths (override if needed)
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
EXTERNAL_DATA_DIR=data/external
